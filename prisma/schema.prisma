// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  phone         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  notifications Notification[]
  carts         Cart[]
  sales         Sales[]
  addresses     UserAddress[]

  @@unique([email])
  @@map("users")
}

model UserAddress {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  address       String
  city          String
  province      String
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at")
  SalesDelivery SalesDelivery[]

  @@map("user_addresses")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? @map("impersonated_by")

  @@unique([token])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("verification")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  subCategories SubCategory[]
  Product       Product[]

  @@map("categories")
}

model SubCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  Product   Product[]

  category Category[]

  @@unique([name])
  @@map("sub_categories")
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  image     String
  link      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("banners")
}

model Announcement {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("announcements")
}

model Notification {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  referenceId   String?  @map("reference_id")
  referenceType String?  @map("reference_type")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  content       String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("notifications")
}

model AdminNotification {
  id            String   @id @default(cuid())
  referenceId   String?  @map("reference_id")
  referenceType String?  @map("reference_type")
  title         String
  content       String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("admin_notifications")
}

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String?
  categoryId    String      @map("category_id")
  subCategoryId String      @map("sub_category_id")
  productTypeId String      @map("product_type_id")
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")

  images ProductImage[]
  carts  Cart[]
  types  ProductType[]
  sales  SalesItem[]

  @@unique([name, subCategoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("product_images")
}

model ProductType {
  id                 String   @id @default(cuid())
  name               String   @unique
  stock              Int      @default(0)
  price              Int
  normalPrice        Int?     @map("normal_price")
  discountPercentage Int?     @map("discount_percentage")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  productId          String   @map("product_id")
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  salesItems SalesItem[]

  @@map("product_types")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@map("carts")
}

model TransferBank {
  id            String   @id @default(cuid())
  name          String
  accountNumber String   @map("account_number")
  accountHolder String   @map("account_holder")
  status        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sales Sales[]

  @@map("transfer_banks")
}

enum SalesStatus {
  PENDING
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
}

// BELI/BAYAR > KONFIRMASI BUKTI WA > ADMIN CEK ID TRANSAKSI > ADMIN APPROVE/CANCEL TRANSAKSI > JIKA APPROVE MAKA STATUS JADI PROCESSING > JIKA CANCEL MAKA STATUS JADI CANCELLED > JIKA PROCESSING MAKA ADMIN KIRIM BARANG > JIKA BARANG DIKIRIM MAKA STATUS JADI SHIPPING > JIKA BARANG DITERIMA PELANGGAN MAKA STATUS JADI COMPLETED

// BELI > KONFIRMASI WA > ADMIN CEK ID TRANSAKSI > ADMIN PROSES > CEK ONGKIR > ADMIN REQUEST BAYAR > SHIPPING > COMPLETED

model Sales {
  id               String      @id @default(cuid())
  total            Int
  totalNormalPrice Int?        @map("total_normal_price")
  status           SalesStatus @default(PENDING)
  userId           String      @map("user_id")
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at")

  items          SalesItem[]
  TransferBank   TransferBank?   @relation(fields: [transferBankId], references: [id])
  transferBankId String?
  delivery       SalesDelivery[]

  @@map("sales")
}

enum DeliveryVendor {
  JNE
  POS_INDONESIA
  TIKI
  SICEPAT
  JNT
  WAHANA
  NINJA_EXPRESS
  ANTERAJA
  SAP
  ID_EXPRESS
  GRAB_EXPRESS
  GO_SEND
}

model SalesDelivery {
  id            String         @id @default(cuid())
  salesId       String         @map("sales_id")
  trackingNo    String         @map("tracking_no")
  vendor        DeliveryVendor
  userAddressId String         @map("user_address_id")
  userAddress   UserAddress    @relation(fields: [userAddressId], references: [id], onDelete: Cascade)
  deliveryFee   Int            @map("delivery_fee")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  sales         Sales          @relation(fields: [salesId], references: [id], onDelete: Cascade)

  @@map("sales_delivery")
}

model SalesItem {
  id                 String      @id @default(cuid())
  saleId             String      @map("sale_id")
  productId          String      @map("product_id")
  productTypeId      String      @map("product_type_id")
  quantity           Int         @default(1)
  price              Int         @default(0)
  normalPrice        Int?        @default(0) @map("normal_price")
  discountPercentage Int?        @default(0) @map("discount_percentage")
  priceAfterDiscount Int         @default(0) @map("price_after_discount")
  sale               Sales       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productType        ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at")

  @@map("sales_items")
}
